            <TextView android:id="@+id/wc1_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:paddingHorizontal="8dp" android:paddingVertical="1dp" android:background="@drawable/w_pill" android:textColor="#F5B942" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/wc1_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:textColor="#A8B7C8" android:textSize="9.5sp" android:maxLines="1" android:ellipsize="end" />
